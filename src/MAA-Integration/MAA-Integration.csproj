<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>MAA-Integration</AssemblyName>
    <RootNamespace>MAAIntegration</RootNamespace>

    <!-- 版本信息：GitHub Release 里会显示 -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>MAA 多配置启动器</Product>
    <AssemblyTitle>MAA 多配置启动器</AssemblyTitle>
    <Description>按顺序用多个配置启动 MAA（MaaAssistantArknights）的小工具</Description>
    <Company>MAA-Integration</Company>
    <Copyright>Copyright © 2026</Copyright>

    <!-- exe 图标（资源管理器/任务栏/快捷方式都取这个） -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 窗口标题栏/taskbar 的图标：把 ico 作为嵌入资源，运行时读出来给 Form.Icon -->
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
